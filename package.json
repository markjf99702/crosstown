{
  "name": "crosstown",
  "private": true,
  "type": "module",
  "description": "A word hunt drawn as a transit map. Every letter is a stop on some line, and one line runs clear across town.",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "test": "node --test test/unit.test.mjs && node test/e2e.mjs",
    "puzzles": "node tools/make-puzzles.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "naughty-words": "^1.2.0",
    "wordlist-english": "^1.2.1"
  }
}
